# Copia este archivo a .env y ajusta los valores.
MYSQL_URL=mysql+pymysql://veritrade:veritrade123@localhost:3307/veritrade?charset=utf8mb4
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Proveedor del agente: deepseek | groq
LLM_PROVIDER=deepseek

# DeepSeek (default): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false

# Groq (fallback): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
