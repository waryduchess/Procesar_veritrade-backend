# Copia este archivo a .env y ajusta los valores.
APP_ENV=local
MYSQL_URL=mysql+pymysql://veritrade:veritrade123@localhost:3307/veritrade?charset=utf8mb4
API_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Autenticación JWT de la suite.
# En local se puede desactivar para usar los tests Bruno sin token.
AUTH_ENABLED=false
JWT_PUBLIC_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=compras-api
JWT_LEEWAY_SECONDS=30
EMPRESA_ID=0
EMPRESA_CLAVE=

# Llave privada solo para el script scripts/dev_jwt.py. No usar en producción.
JWT_PRIVATE_KEY_PATH=

# Proveedor del agente: deepseek | groq
LLM_PROVIDER=deepseek

# DeepSeek (default): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false

# Groq (fallback): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Agente
# 0 en los límites de tokens = no imponer límite desde la app (usa el máximo del proveedor).
AGENTE_MAX_TOOL_CALLS=12
AGENTE_MAX_TOKENS=0
AGENTE_INFORME_MAX_TOKENS=0
AGENTE_TIMEOUT=120
AGENTE_HISTORIAL_MENSAJES=12
AGENTE_HISTORIAL_CHARS=12000
AGENTE_HISTORIAL_RESUMEN_CHARS=2000
