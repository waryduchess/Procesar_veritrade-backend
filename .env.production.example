# Copia este archivo a .env en el VPS y ajusta los valores.
# La API publica el puerto solo en 127.0.0.1; el frontend/proxy debe usar la red veritrade_net.
APP_ENV=production
MYSQL_URL=mysql+pymysql://usuario:password@db-host:3306/veritrade?charset=utf8mb4
API_PORT=8001
CORS_ORIGINS=https://app.tu-dominio.com

# Autenticación JWT emitida por la suite PHP.
# Monta la llave pública en el contenedor (volumen o secret) en esa ruta.
AUTH_ENABLED=true
JWT_PUBLIC_KEY_PATH=/run/secrets/compras-jwt-public.pem
JWT_PUBLIC_KEY=
JWT_ISSUER=https://suite.tu-dominio.com/
JWT_AUDIENCE=compras-api
JWT_LEEWAY_SECONDS=30
EMPRESA_ID=1
EMPRESA_CLAVE=REEMPLAZAR

# Proveedor del agente: deepseek | groq
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false

# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Agente
# 0 en los límites de tokens = no imponer límite desde la app (usa el máximo del proveedor).
AGENTE_MAX_TOOL_CALLS=12
AGENTE_MAX_TOKENS=0
AGENTE_INFORME_MAX_TOKENS=0
AGENTE_TIMEOUT=120
AGENTE_HISTORIAL_MENSAJES=12
AGENTE_HISTORIAL_CHARS=12000
AGENTE_HISTORIAL_RESUMEN_CHARS=2000
