# Copia este archivo a .env en el VPS y ajusta los valores.
# No subas el .env real al repositorio.

APP_ENV=production

# Base de datos del contenedor
MYSQL_ROOT_PASSWORD=CAMBIA_ESTO
MYSQL_DATABASE=veritrade
MYSQL_USER=veritrade
MYSQL_PASSWORD=CAMBIA_ESTO
MYSQL_PORT=3307
# Usa la misma contraseña que MYSQL_PASSWORD. Si tiene caracteres especiales,
# codifícala para URL o usa una contraseña simple.
MYSQL_URL=mysql+pymysql://veritrade:CAMBIA_ESTO@db:3306/veritrade?charset=utf8mb4

# API
API_PORT=8001
CORS_ORIGINS=https://dev.horbismex.com,https://app.horbismex.com

# Autenticación JWT emitida por la suite PHP
# En la primera prueba del proxy se puede dejar false.
# Cámbialo a true cuando api/auth/context.php esté desplegado en la suite.
AUTH_ENABLED=false
JWT_KEYS_DIR=/root/horbis-jwt-keys
JWT_PUBLIC_KEY_PATH=/run/secrets/compras-public.pem
JWT_ISSUER=https://dev.horbismex.com/
JWT_AUDIENCE=compras-api
JWT_LEEWAY_SECONDS=30
EMPRESA_ID=1
EMPRESA_CLAVE=CAMBIA_ESTO

# Red compartida con el frontend
VERITRADE_NETWORK=veritrade_vps_net

# Proveedor del agente
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=false

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

AGENTE_MAX_TOOL_CALLS=12
AGENTE_MAX_TOKENS=0
AGENTE_INFORME_MAX_TOKENS=0
AGENTE_TIMEOUT=120
AGENTE_HISTORIAL_MENSAJES=12
AGENTE_HISTORIAL_CHARS=12000
AGENTE_HISTORIAL_RESUMEN_CHARS=2000
